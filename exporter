import java.awt.AWTException;
import java.awt.Robot;
import java.util.Random;

public class PdfSim {

    public static void main(String[] args) {
        // ────────────────────────────────────────────────
        // Configuration - change these values as needed
        // ────────────────────────────────────────────────
        int totalSeconds            = 600;     // total simulation time in seconds (10 minutes)
        double probabilityLongPause = 0.14;
        double probabilityBackScroll= 0.11;
        // ────────────────────────────────────────────────

        System.out.printf("Starting human-like scrolling simulation for %d seconds (~%d min)%n",
                totalSeconds, totalSeconds / 60);

        // Give you time to open the PDF and focus the viewer window
        System.out.println("Please open your PDF file now and make sure the document window is active.");
        System.out.println("Program will start in 8 seconds...");
        sleep(8000);

        Robot robot;
        try {
            robot = new Robot();
        } catch (AWTException e) {
            System.err.println("Failed to initialize java.awt.Robot: " + e.getMessage());
            return;
        }

        Random rand = new Random();
        long start = System.currentTimeMillis();
        long end   = start + (totalSeconds * 1000L);

        while (System.currentTimeMillis() < end) {
            // Normal forward scroll (down the page)
            int scrollDown = rand.nextInt(201) + 80;           // 80–280
            robot.mouseWheel(scrollDown);

            // Short random pause after each scroll
            double shortPauseSec = 0.6 + rand.nextDouble() * 1.7;  // 0.6 – 2.3 s
            sleep((long)(shortPauseSec * 1000));

            // Occasional long "thinking/reading" pause
            if (rand.nextDouble() < probabilityLongPause) {
                double longPauseSec = 4.5 + rand.nextDouble() * 9.5;  // 4.5 – 14.0 s
                sleep((long)(longPauseSec * 1000));
            }

            // Occasional "go back to re-read" behavior
            if (rand.nextDouble() < probabilityBackScroll) {
                int backAmount = rand.nextInt(241) + 180;     // 180–420
                robot.mouseWheel(-backAmount);                 // scroll up

                double reviewPauseSec = 3.5 + rand.nextDouble() * 6.0;  // 3.5 – 9.5 s
                sleep((long)(reviewPauseSec * 1000));

                robot.mouseWheel(backAmount);                  // scroll down again
            }
        }

        System.out.println("Simulation completed.");
    }

    private static void sleep(long millis) {
        try {
            Thread.sleep(millis);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}
